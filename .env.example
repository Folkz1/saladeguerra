# Porta do app (EasyPanel injeta PORT automaticamente)
PORT=3000

# Chave para autorizar atualizações automáticas do board
UPDATE_API_KEY=troque-por-uma-chave-forte

# Caminho do arquivo de dados (opcional)
BOARD_DATA_FILE=./data/board.json

# URL pública da sua sala de guerra (opcional)
PUBLIC_URL=https://sua-sala-de-guerra.seudominio.com
